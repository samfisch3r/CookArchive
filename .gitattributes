# Auto detect text files and perform LF normalization
* text=auto

# Specify text files to always use LF (Unix-style) line endings on checkout
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.gradle text eol=lf
.gitignore text eol=lf

# Keep Windows batch scripts with CRLF
*.bat text eol=crlf

# Keep bash scripts with LF
gradlew text eol=lf

# Binary files (do not touch line endings)
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.jar binary
*.keystore binary
